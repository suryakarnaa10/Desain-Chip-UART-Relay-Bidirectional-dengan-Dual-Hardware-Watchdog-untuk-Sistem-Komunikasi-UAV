VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO sistem_lengkap
  CLASS BLOCK ;
  FOREIGN sistem_lengkap ;
  ORIGIN 0.000 0.000 ;
  SIZE 179.315 BY 190.035 ;
